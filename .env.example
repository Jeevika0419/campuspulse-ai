# =========================================================================
# CampusPulse AI — Environment Configuration Template
# =========================================================================

# Database Configuration (Use localhost for dev or AWS RDS endpoint for production)
MYSQL_HOST=localhost
# MYSQL_HOST=campuspulse-mysql.c3xxxx.ap-south-1.rds.amazonaws.com  # AWS RDS Endpoint
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=campus_issue_system
MYSQL_PORT=3306

# Flask Web Server Settings
SECRET_KEY=generate-a-strong-random-key-here
FLASK_ENV=production
FLASK_DEBUG=0

# AWS Cloud Infrastructure Configuration
# EC2, S3, SNS, and CloudWatch (Supports AWS Academy Learner Lab credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=ASIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
AWS_SESSION_TOKEN=IQoJb3JpZ2luX2VjE...
AWS_S3_BUCKET=campuspulse-issue-attachments
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:campuspulse-infrastructure-alerts
AWS_CLOUDWATCH_NAMESPACE=CampusPulse/Infrastructure
